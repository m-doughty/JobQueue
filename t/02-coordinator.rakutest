use Test;
use lib 'lib';

use JobQueue::Job;
use JobQueue::Queue;
use JobQueue::Coordinator;

# The DAG coordinator: named-queue registry, dependency hold/release,
# dep-result injection, cascade supersede, cross-queue edges, dedup
# across held + queued jobs.

plan 19;

class TestJob does Job {
    has Str $.kind = 'test';
    has %.params;
    has Int $.message-id is rw;

    method dep-extras(--> Hash) {
        $!message-id.defined ?? %( message-id => $!message-id ) !! %();
    }
}

class MidTickFinisherJob does Job {
    has Str $.kind = 'mid-tick-finisher';
    has $.finish-target is required;

    method dep-extras(--> Hash) {
        $!finish-target.result = %( finished => 'during-tick' );
        $!finish-target.finish('done');
        %()
    }
}

class ProbeStore {
    has @.events;
    method dispatch(Str:D $event, *%payload) {
        @!events.push: %( :$event, |%payload );
    }
}

sub wait-for(&cond, Num :$timeout = 5e0) {
    my $t0 = now;
    until &cond() || now - $t0 > $timeout {
        await Promise.in(0.02);
    }
}

# A queue whose runners wait on per-job gates.
sub make-queue(Str $name, %gates, :$store) {
    JobQueue::Queue.new(
        :$name, :$store,
        is-parallel-now => -> { True },
        run-job         => -> $job {
            %gates{$job.id} = my $g = Promise.new;
            start { (await $g) // 'done' }
        },
    );
}

sub make-coord(%gates, :$store) {
    my $coord = JobQueue::Coordinator.new(:$store);
    $coord.register-queue('q-a', make-queue('q-a', %gates, :$store));
    $coord.register-queue('q-b', make-queue('q-b', %gates, :$store));
    $coord;
}

sub job($scope = 1, *%extra) {
    TestJob.new(scope-id => $scope, |%extra);
}

sub finish-and-prune($coord, %gates, $job, Str:D $outcome --> Nil) {
    wait-for(-> { %gates{$job.id}:exists });
    given $outcome {
        when 'cancelled' {
            $coord.cancel($job.id);
            %gates{$job.id}.keep('done');
        }
        when 'superseded' {
            $coord.supersede($job.id);
            %gates{$job.id}.keep('done');
        }
        default {
            %gates{$job.id}.keep($outcome);
        }
    }
    await $job.completion;
    wait-for(-> { $coord.queue($job.queue-name).total-count == 0 });
    $coord.tick;
    wait-for(-> { !$coord.find-job($job.id).defined });
}

subtest 'independent job dispatches immediately' => {
    plan 2;
    my %gates;
    my $coord = make-coord(%gates);
    my $j = $coord.submit('q-a', job());
    wait-for(-> { %gates{$j.id}:exists });
    ok %gates{$j.id}:exists, 'runner started without a tick';
    %gates{$j.id}.keep('done');
    await $j.completion;
    is $j.state, 'done', 'completes normally';
};

subtest 'hard dependency holds, releases on done, injects dep-results' => {
    plan 7;
    my %gates;
    my $probe = ProbeStore.new;
    my $coord = make-coord(%gates, store => $probe);

    my $dep = $coord.submit('q-a', job());
    $dep.message-id = 512;
    my $child = $coord.submit('q-a', job(1, depends-on => [$dep.id]));

    wait-for(-> { %gates{$dep.id}:exists });
    nok %gates{$child.id}:exists, 'dependent held while dep runs';
    ok $probe.events.first({
        $_<event> eq 'queue/job-waiting' && $_<job><id> eq $child.id
    }), 'held job announced as waiting';

    $dep.result = %( answer => 42 );
    %gates{$dep.id}.keep('done');
    await $dep.completion;
    $coord.tick;
    wait-for(-> { %gates{$child.id}:exists });
    ok %gates{$child.id}:exists, 'dependent released after dep done';
    is $child.dep-results{$dep.id}<state>, 'done', 'dep state injected';
    is $child.dep-results{$dep.id}<result><answer>, 42, 'dep result injected';
    is $child.dep-results{$dep.id}<message-id>, 512,
        'dep-extras injected alongside state + result';

    %gates{$child.id}.keep('done');
    await $child.completion;
    is $child.state, 'done', 'dependent completes';
};

subtest 'hard dependency failure supersedes the dependent' => {
    plan 3;
    my %gates;
    my $probe = ProbeStore.new;
    my $coord = make-coord(%gates, store => $probe);

    my $dep = $coord.submit('q-a', job());
    my $child = $coord.submit('q-a', job(1, depends-on => [$dep.id]));
    wait-for(-> { %gates{$dep.id}:exists });

    %gates{$dep.id}.keep('error');
    await $dep.completion;
    $coord.tick;
    wait-for(-> { $child.completion.status ~~ Kept });

    is $child.state, 'superseded', 'dependent superseded on dep failure';
    nok %gates{$child.id}:exists, 'dependent never ran';
    ok $probe.events.first({
        $_<event> eq 'queue/job-superseded' && $_<job><id> eq $child.id
    }), 'superseded event dispatched';
};

subtest 'soft (after) dependency runs regardless of outcome' => {
    plan 3;
    my %gates;
    my $coord = make-coord(%gates);

    my $dep = $coord.submit('q-a', job());
    my $child = $coord.submit('q-a', job(1, after => [$dep.id]));
    wait-for(-> { %gates{$dep.id}:exists });
    nok %gates{$child.id}:exists, 'soft dependent waits for terminal';

    %gates{$dep.id}.keep('error');
    await $dep.completion;
    $coord.tick;
    wait-for(-> { %gates{$child.id}:exists });
    ok %gates{$child.id}:exists, 'soft dependent runs after dep FAILURE';
    is $child.dep-results{$dep.id}<state>, 'error',
        'failure outcome visible in dep-results';

    %gates{$child.id}.keep('done');
    await $child.completion;
};

subtest 'cancel cascades over hard edges, spares soft edges' => {
    plan 4;
    my %gates;
    my $coord = make-coord(%gates);

    my $root = $coord.submit('q-a', job());
    my $hard = $coord.submit('q-a', job(1, depends-on => [$root.id]));
    my $grand = $coord.submit('q-b', job(1, depends-on => [$hard.id]));
    my $soft = $coord.submit('q-a', job(1, after => [$root.id]));
    wait-for(-> { %gates{$root.id}:exists });

    $coord.cancel($root.id);
    %gates{$root.id}.keep('cancelled');
    await $root.completion;
    $coord.tick;
    wait-for(-> { $grand.completion.status ~~ Kept });

    is $root.state, 'cancelled', 'root cancelled';
    is $hard.state, 'superseded', 'hard dependent superseded';
    is $grand.state, 'superseded', 'cascade crosses queues transitively';
    # Soft dependent released to run once the root is terminal.
    $coord.tick;
    wait-for(-> { %gates{$soft.id}:exists });
    %gates{$soft.id}.keep('done');
    await $soft.completion;
    is $soft.state, 'done', 'soft dependent survived the cascade';
};

subtest 'cross-queue hard edge: dep on q-a releases dependent on q-b' => {
    plan 2;
    my %gates;
    my $coord = make-coord(%gates);
    my $dep = $coord.submit('q-a', job());
    my $child = $coord.submit('q-b', job(1, depends-on => [$dep.id]));
    wait-for(-> { %gates{$dep.id}:exists });
    %gates{$dep.id}.keep('done');
    await $dep.completion;
    $coord.tick;
    wait-for(-> { %gates{$child.id}:exists });
    ok %gates{$child.id}:exists, 'released across queues';
    %gates{$child.id}.keep('done');
    await $child.completion;
    is $child.state, 'done', 'runs to completion on its own queue';
};

subtest 'dedup across held and queued jobs' => {
    plan 3;
    my %gates;
    my $coord = make-coord(%gates);

    my $dep = $coord.submit('q-a', job());
    my $held = $coord.submit('q-a', job(1,
        depends-on => [$dep.id], dedup-key => 'HK'));
    my $dup-held = $coord.submit('q-a', job(1, dedup-key => 'HK'));
    is $dup-held.id, $held.id, 'held job wins dedup';

    my $queued = $coord.submit('q-a', job(1, dedup-key => 'QK'));
    my $dup-queued = $coord.submit('q-a', job(1, dedup-key => 'QK'));
    is $dup-queued.id, $queued.id, 'queued/running job wins dedup';

    wait-for(-> { (%gates{$dep.id}:exists) && (%gates{$queued.id}:exists) });
    %gates{$dep.id}.keep('done');
    await $dep.completion;
    $coord.tick;
    wait-for(-> { %gates{$held.id}:exists });
    %gates{$held.id}.keep('done');
    %gates{$queued.id}.keep('done');
    await Promise.allof($held.completion, $queued.completion);
    ok True, 'both keyed jobs drained';
};

subtest 'unknown hard dependency fails fast as superseded' => {
    plan 3;
    my %gates;
    my @logged;
    my $log = class { has @.lines;
        method debug(Str:D $v, *%f --> Nil) { }
        method info(Str:D $v, *%f --> Nil) { }
        method error(Str:D $v, *%f --> Nil) { @!lines.push: $v }
    }.new;
    my $coord = JobQueue::Coordinator.new(:$log);
    $coord.register-queue('q-a', make-queue('q-a', %gates));
    my $child = $coord.submit('q-a', job(1, depends-on => ['no-such-job']));
    wait-for(-> { $child.completion.status ~~ Kept });
    is $child.state, 'superseded', 'doomed immediately';
    nok %gates{$child.id}:exists, 'never ran';
    ok $log.lines.first(* eq 'coordinator/unknown-dependency'),
        'the unknown dependency was logged as an error';
};

subtest 'unknown SOFT dependency is skipped, not doomed' => {
    # Soft edges are best-effort: an "after" pointing at something
    # that was never submitted is satisfied by definition, otherwise a
    # probabilistic precursor that didn't fire would kill the work
    # behind it.
    plan 2;
    my %gates;
    my $coord = make-coord(%gates);
    my $child = $coord.submit('q-a', job(1, after => ['no-such-job']));
    wait-for(-> { %gates{$child.id}:exists });
    ok %gates{$child.id}:exists, 'ran anyway';
    %gates{$child.id}.keep('done');
    await $child.completion;
    is $child.state, 'done', 'completed normally';
};

subtest 'dependency-state reports scheduler readiness decisions' => {
    plan 25;

    my %gates;
    my $coord = make-coord(%gates);
    my $first = $coord.submit('q-a', job());
    my $second = $coord.submit('q-a', job());
    my $child = $coord.submit('q-b', job(1,
        depends-on => [$first.id, $second.id]));
    wait-for(-> { (%gates{$first.id}:exists) && (%gates{$second.id}:exists) });

    is $child.dependency-state<status>, 'blocked',
        'hard dependent reports blocked while first hard dep runs';
    is $child.dependency-state<prerequisite-id>, $first.id,
        'first hard blocker is reported';
    is $child.dependency-state<required-state>, 'done',
        'hard blocker reports required done state';

    %gates{$first.id}.keep('done');
    await $first.completion;
    $coord.tick;
    is $child.dependency-state<status>, 'blocked',
        'child remains blocked after only first dep completes';
    is $child.dependency-state<prerequisite-id>, $second.id,
        'first blocker advances to the remaining hard dep';

    %gates{$second.id}.keep('done');
    await $second.completion;
    $coord.tick;
    wait-for(-> { %gates{$child.id}:exists });
    is $child.dependency-state<status>, 'ready',
        'hard dependent reports ready from the releasing resolution pass';
    ok %gates{$child.id}:exists, 'ready child was released';
    %gates{$child.id}.keep('done');
    await $child.completion;

    my %failure-gates;
    my $failure-coord = make-coord(%failure-gates);
    my $waiting = $failure-coord.submit('q-a', job());
    my $failing = $failure-coord.submit('q-a', job());
    my $doomed = $failure-coord.submit('q-b', job(1,
        depends-on => [$waiting.id, $failing.id]));
    wait-for(-> {
        (%failure-gates{$waiting.id}:exists)
        && (%failure-gates{$failing.id}:exists)
    });
    is $doomed.dependency-state<prerequisite-id>, $waiting.id,
        'earlier hard wait is reported before failure exists';
    %failure-gates{$failing.id}.keep('error');
    await $failing.completion;
    $failure-coord.tick;
    wait-for(-> { $doomed.completion.status ~~ Kept });
    is $doomed.dependency-state<status>, 'doomed',
        'hard failure dominates an earlier waiting hard dep';
    is $doomed.dependency-state<prerequisite-id>, $failing.id,
        'doomed report identifies the failed hard dep';
    is $doomed.dependency-state<prerequisite-state>, 'error',
        'doomed report carries the terminal failure state';
    is $doomed.state, 'superseded', 'doomed child was superseded';
    %failure-gates{$waiting.id}.keep('done');
    await $waiting.completion;

    my %unknown-gates;
    my $unknown-coord = make-coord(%unknown-gates);
    my $unknown-hard = $unknown-coord.submit('q-a',
        job(1, depends-on => ['missing-hard']));
    wait-for(-> { $unknown-hard.completion.status ~~ Kept });
    is $unknown-hard.dependency-state<status>, 'doomed',
        'unknown hard dependency reports doomed';
    is $unknown-hard.dependency-state<prerequisite-state>, 'unknown',
        'unknown hard dependency reports unknown state';

    my $unknown-soft = $unknown-coord.submit('q-a',
        job(1, after => ['missing-soft']));
    wait-for(-> { %unknown-gates{$unknown-soft.id}:exists });
    is $unknown-soft.dependency-state<status>, 'ready',
        'unknown soft dependency is ignored as ready';
    ok %unknown-gates{$unknown-soft.id}:exists,
        'unknown-soft job was released';
    %unknown-gates{$unknown-soft.id}.keep('done');
    await $unknown-soft.completion;

    my %soft-gates;
    my $soft-coord = make-coord(%soft-gates);
    my $soft-dep = $soft-coord.submit('q-a', job());
    my $soft-child = $soft-coord.submit('q-b',
        job(1, after => [$soft-dep.id]));
    wait-for(-> { %soft-gates{$soft-dep.id}:exists });
    is $soft-child.dependency-state<status>, 'blocked',
        'soft dependent reports blocked while precursor runs';
    is $soft-child.dependency-state<edge>, 'after',
        'soft blocker records after edge';
    is $soft-child.dependency-state<required-state>, 'terminal',
        'soft blocker requires any terminal state';
    is $soft-child.dependency-state<prerequisite-state>, 'running',
        'soft blocker reports known nonterminal state';

    %soft-gates{$soft-dep.id}.keep('error');
    await $soft-dep.completion;
    $soft-coord.tick;
    wait-for(-> { %soft-gates{$soft-child.id}:exists });
    is $soft-child.dependency-state<status>, 'ready',
        'soft dependent reports ready after failed terminal outcome';
    is $soft-child.dep-results{$soft-dep.id}<state>, 'error',
        'soft dependent still receives the failed terminal handoff';

    my %detached = $soft-child.dependency-state;
    %detached<status> = 'mutated';
    is $soft-child.dependency-state<status>, 'ready',
        'dependency-state getter returns detached data';
    nok $soft-child.dependency-state<result>:exists,
        'dependency-state report contains no dependency result body';
    %soft-gates{$soft-child.id}.keep('done');
    await $soft-child.completion;
    $soft-coord.tick;
    is $soft-child.dependency-state<status>, 'ready',
        'last dependency-state remains after terminal and pruning';
};

subtest 'explicit hard cascade records actual failed prerequisite' => {
    plan 14;

    for <cancelled superseded> -> $outcome {
        my %gates;
        my $probe = ProbeStore.new;
        my $coord = make-coord(%gates, store => $probe);

        my $earlier = $coord.submit('q-a', job());
        my $actual = $coord.submit('q-a', job());
        my $child = $coord.submit('q-b', job(1,
            depends-on => [$earlier.id, $actual.id]));
        wait-for(-> {
            (%gates{$earlier.id}:exists) && (%gates{$actual.id}:exists)
        });

        is $child.dependency-state<prerequisite-id>, $earlier.id,
            "$outcome cascade starts with earlier hard wait reported";

        if $outcome eq 'cancelled' {
            ok $coord.cancel($actual.id), 'explicit cancel won';
        } else {
            ok $coord.supersede($actual.id), 'explicit supersede won';
        }
        wait-for(-> { $child.completion.status ~~ Kept });

        is $child.dependency-state<status>, 'doomed',
            "$outcome cascade records doomed report";
        is $child.dependency-state<prerequisite-id>, $actual.id,
            "$outcome cascade reports the actual failed prerequisite";
        is $child.dependency-state<prerequisite-state>, $outcome,
            "$outcome cascade reports the exact prerequisite outcome";
        is $child.state, 'superseded',
            "$outcome cascade superseded the held child";

        my $ev = $probe.events.first({
            $_<event> eq 'queue/job-superseded'
            && $_<job><id> eq $child.id
        });
        is $ev<job><dependency-state><prerequisite-id>, $actual.id,
            "$outcome terminal snapshot includes the cascade report";

        %gates{$actual.id}.keep('done');
        %gates{$earlier.id}.keep('done');
        await Promise.allof($actual.completion, $earlier.completion);
    }
};

subtest 'late dependents use retained outcomes after predecessor prune' => {
    plan 22;
    for <done error cancelled superseded> -> $outcome {
        my %gates;
        my $coord = make-coord(%gates);
        my $dep = $coord.submit('q-a', job());
        $dep.message-id = 700 + $outcome.chars;
        $dep.result = %( outcome => $outcome );

        finish-and-prune($coord, %gates, $dep, $outcome);
        nok $coord.find-job($dep.id).defined,
            "$outcome predecessor pruned before late submit";

        my $hard = $coord.submit('q-a', job(1, depends-on => [$dep.id]));
        if $outcome eq 'done' {
            wait-for(-> { %gates{$hard.id}:exists });
            ok %gates{$hard.id}:exists,
                'late hard dependent runs after retained success';
            is $hard.dep-results{$dep.id}<state>, 'done',
                'late hard dependent sees retained done state';
            is $hard.dep-results{$dep.id}<result><outcome>, $outcome,
                'late hard dependent sees retained result';
            is $hard.dep-results{$dep.id}<message-id>, $dep.message-id,
                'late hard dependent sees retained dep-extras';
            %gates{$hard.id}.keep('done');
            await $hard.completion;
        } else {
            wait-for(-> { $hard.completion.status ~~ Kept });
            is $hard.state, 'superseded',
                "late hard dependent superseded after retained $outcome";
            nok %gates{$hard.id}:exists,
                "late hard dependent never runs after retained $outcome";
        }

        my $soft = $coord.submit('q-b', job(1, after => [$dep.id]));
        wait-for(-> { %gates{$soft.id}:exists });
        ok %gates{$soft.id}:exists,
            "late soft dependent runs after retained $outcome";
        is $soft.dep-results{$dep.id}<state>, $outcome,
            "late soft dependent sees retained $outcome state";
        %gates{$soft.id}.keep('done');
        await $soft.completion;
    }
};

subtest 'retained outcomes support late dependency chains' => {
    plan 8;
    my %gates;
    my $coord = make-coord(%gates);

    my $root = $coord.submit('q-a', job());
    $root.result = %( stage => 'root' );
    finish-and-prune($coord, %gates, $root, 'done');

    my $middle = $coord.submit('q-a', job(1, depends-on => [$root.id]));
    wait-for(-> { %gates{$middle.id}:exists });
    ok %gates{$middle.id}:exists, 'middle released from retained root';
    is $middle.dep-results{$root.id}<result><stage>, 'root',
        'middle sees retained root result';
    $middle.result = %( stage => 'middle' );
    finish-and-prune($coord, %gates, $middle, 'done');
    nok $coord.find-job($middle.id).defined, 'middle pruned before leaf submit';

    my $leaf = $coord.submit('q-b', job(1, depends-on => [$middle.id]));
    wait-for(-> { %gates{$leaf.id}:exists });
    ok %gates{$leaf.id}:exists, 'leaf released from retained middle';
    is $leaf.dep-results{$middle.id}<state>, 'done',
        'leaf sees retained middle state';
    is $leaf.dep-results{$middle.id}<result><stage>, 'middle',
        'leaf sees retained middle result';
    nok $leaf.dep-results{$root.id}:exists,
        'leaf receives only its declared dependency result';
    %gates{$leaf.id}.keep('done');
    await $leaf.completion;
    is $leaf.state, 'done', 'late chain drains normally';
};

subtest 'mid-tick terminal jobs are not pruned without retention' => {
    plan 5;
    my %gates;
    my $coord = make-coord(%gates);

    my $victim = $coord.submit('q-a', job());
    wait-for(-> { %gates{$victim.id}:exists });
    my $finisher = $coord.submit('q-a', MidTickFinisherJob.new(
        scope-id => 1,
        finish-target => $victim,
    ));
    wait-for(-> { %gates{$finisher.id}:exists });

    %gates{$finisher.id}.keep('done');
    await $finisher.completion;
    $coord.tick;

    is $victim.state, 'done', 'second job became terminal during tick';
    ok $coord.find-job($victim.id).defined,
        'mid-tick terminal job remains coordinator-visible until next tick';

    my $child = $coord.submit('q-b', job(1, depends-on => [$victim.id]));
    wait-for(-> { %gates{$child.id}:exists });
    ok %gates{$child.id}:exists,
        'late hard dependent resolves mid-tick terminal predecessor';
    is $child.dep-results{$victim.id}<result><finished>, 'during-tick',
        'mid-tick predecessor result is injected';

    %gates{$victim.id}.keep('done');
    %gates{$child.id}.keep('done');
    await Promise.allof($victim.completion, $child.completion);
    is $child.state, 'done', 'dependent drains';
};

subtest 'held child pins cached terminal dependency until second dep finishes' => {
    plan 6;
    my %gates;
    my $coord = JobQueue::Coordinator.new(terminal-outcome-limit => 1);
    $coord.register-queue('q-a', make-queue('q-a', %gates));
    $coord.register-queue('q-b', make-queue('q-b', %gates));

    my $first = $coord.submit('q-a', job());
    $first.result = %( stage => 'first' );
    finish-and-prune($coord, %gates, $first, 'done');

    my $second = $coord.submit('q-a', job());
    wait-for(-> { %gates{$second.id}:exists });
    my $child = $coord.submit('q-b', job(1,
        depends-on => [$second.id, $first.id]));
    nok %gates{$child.id}:exists, 'child waits on second dependency';

    my $evictor = $coord.submit('q-b', job());
    finish-and-prune($coord, %gates, $evictor, 'done');

    $second.result = %( stage => 'second' );
    %gates{$second.id}.keep('done');
    await $second.completion;
    $coord.tick;
    wait-for(-> { %gates{$child.id}:exists });

    ok %gates{$child.id}:exists,
        'child releases after second dependency finishes';
    is $child.dep-results{$first.id}<state>, 'done',
        'first dependency state survived cache eviction while pinned';
    is $child.dep-results{$first.id}<result><stage>, 'first',
        'first dependency result survived cache eviction while pinned';
    is $child.dep-results{$second.id}<result><stage>, 'second',
        'second dependency result injected at release';

    $child.dep-results{$second.id}<state> = 'mutated-copy';
    my $late = $coord.submit('q-a', job(1, depends-on => [$second.id]));
    wait-for(-> { %gates{$late.id}:exists });
    is $late.dep-results{$second.id}<state>, 'done',
        'mutating dep-results copy did not mutate retained outcome';

    %gates{$late.id}.keep('done');
    %gates{$child.id}.keep('done');
    await Promise.allof($late.completion, $child.completion);
};

subtest 'terminal outcome retention is bounded' => {
    plan 6;
    my %gates;
    my $coord = JobQueue::Coordinator.new(terminal-outcome-limit => 1);
    $coord.register-queue('q-a', make-queue('q-a', %gates));

    my $evicted = $coord.submit('q-a', job());
    finish-and-prune($coord, %gates, $evicted, 'done');
    my $retained = $coord.submit('q-a', job());
    finish-and-prune($coord, %gates, $retained, 'done');

    my $new-child = $coord.submit('q-a', job(1,
        depends-on => [$retained.id]));
    wait-for(-> { %gates{$new-child.id}:exists });
    ok %gates{$new-child.id}:exists,
        'newest retained hard dependency still releases';
    is $new-child.dep-results{$retained.id}<state>, 'done',
        'newest retained outcome injected';
    %gates{$new-child.id}.keep('done');
    await $new-child.completion;

    my $old-child = $coord.submit('q-a', job(1,
        depends-on => [$evicted.id]));
    wait-for(-> { $old-child.completion.status ~~ Kept });
    is $old-child.state, 'superseded',
        'hard dependency older than retention bound is unknown';
    nok %gates{$old-child.id}:exists, 'evicted hard dependent never ran';

    my $soft-old = $coord.submit('q-a', job(1, after => [$evicted.id]));
    wait-for(-> { %gates{$soft-old.id}:exists });
    ok %gates{$soft-old.id}:exists,
        'evicted soft dependency keeps unknown-soft behavior';

    %gates{$soft-old.id}.keep('done');
    await $soft-old.completion;
    is $coord.total-active, 0, 'bounded-retention jobs drain';
};

subtest 'total-active counts live work only, never drainers' => {
    # A reply lock keys on total-active: a cancelled job still
    # draining its unabortable call occupies the backend but is
    # nothing the user waits on — it must not keep the input locked.
    plan 5;
    my %gates;
    my $coord = make-coord(%gates);
    my $a = job(1);
    $coord.submit('q-a', $a);
    wait-for(-> { %gates{$a.id}:exists });
    is $coord.total-active, 1, 'running job counts';

    my $held = job(1, depends-on => [$a.id]);
    $coord.submit('q-b', $held);
    is $coord.total-active, 2, 'held dependent counts';

    # Cancel the running job; its gate stays closed — a live drain.
    $coord.cancel($a.id);
    $coord.tick;
    is $coord.total-active, 0,
        'drainer and its superseded dependent are not live work';

    # Drain ends: still zero, and nothing resurrects.
    %gates{$a.id}.keep('done');
    wait-for(-> { $coord.queue('q-a').running-count == 0 });
    is $coord.total-active, 0, 'drain end leaves zero';
    is $coord.queue('q-a').total-count, 0, 'queue fully empty';
};

subtest 'find-jobs filters by scope (eqv) and by an arbitrary predicate' => {
    plan 6;
    my %gates;
    my $coord = make-coord(%gates);
    # Str and Int scopes that stringify identically must not merge.
    my $int-job = $coord.submit('q-a', job(7));
    my $str-job = $coord.submit('q-a', job('7'));
    my $tagged  = $coord.submit('q-b', job(7));
    $tagged.message-id = 99;
    wait-for(-> {
        (%gates{$int-job.id}:exists) && (%gates{$str-job.id}:exists)
        && (%gates{$tagged.id}:exists)
    });

    is $coord.find-jobs.elems, 3, 'no filter returns every live job';
    is-deeply $coord.find-jobs(scope-id => '7').map(*.id).List,
        ($str-job.id,), 'Str scope matches only the Str-scoped job';
    is $coord.find-jobs(scope-id => 7).elems, 2,
        'Int scope matches both Int-scoped jobs';
    is-deeply $coord.find-jobs(
            scope-id => 7,
            where    => -> $j { ($j.message-id // 0) == 99 },
        ).map(*.id).List,
        ($tagged.id,), 'predicate narrows within a scope';
    is $coord.find-jobs(where => -> $j { $j.scope-id eqv 'nope' }).elems, 0,
        'a predicate that matches nothing returns an empty Seq';

    .keep('done') for %gates.values;
    await Promise.allof($int-job.completion, $str-job.completion,
        $tagged.completion);
    wait-for(-> { $coord.total-active == 0 });
    is $coord.find-jobs.elems, 0, 'terminal jobs are not live';
};

subtest 'registry surface: duplicate names die, unknown names die, find-job falls through' => {
    plan 6;
    my %gates;
    my $coord = make-coord(%gates);
    dies-ok { $coord.register-queue('q-a', make-queue('dup', %gates)) },
        'registering a duplicate queue name dies';
    dies-ok { $coord.submit('q-nope', job()) },
        'submitting to an unknown queue dies';
    ok $coord.queue('q-a').defined, 'registered queue is retrievable';
    nok $coord.queue('q-nope').defined, 'unknown queue name returns Nil';

    # A job enqueued straight onto a queue is invisible to the
    # coordinator's bookkeeping but must still be findable and
    # cancellable — the fall-through scan over registered queues.
    my $direct = job(3);
    $coord.queue('q-a').enqueue($direct);
    wait-for(-> { %gates{$direct.id}:exists });
    is $coord.find-job($direct.id).id, $direct.id,
        'find-job falls through to the queues';
    ok $coord.cancel($direct.id), 'cancel falls through to the queues';
    %gates{$direct.id}.keep('done');
    await $direct.completion;
};
